-- ==========================================
-- 辅助函数：收集 MACA SDK 路径
-- ==========================================
local function _collect_maca_roots()
    local roots = {}

    -- 1. 优先检查 xmake 配置项
    local maca_sdk = get_config("maca-sdk")
    if maca_sdk and maca_sdk ~= "" then
        table.insert(roots, maca_sdk)
    end

    -- 2. 检查环境变量 (支持 MACA_PATH)
    local env_vars = {
        "MACA_PATH",      -- <--- 你提供的环境变量名
        "MXMACA_HOME",
        "MACA_HOME",
        "MACA_SDK_HOME",
        "MX_HOME",
        "MXSDK_HOME"
    }
    for _, env_name in ipairs(env_vars) do
        local p = os.getenv(env_name)
        if p and p ~= "" then
            table.insert(roots, p)
        end
    end

    -- 3. 默认安装路径
    local default_roots = {
        "/opt/maca",
        "/usr/local/maca",
        "/opt/mx",
        "/usr/local/mx"
    }
    for _, p in ipairs(default_roots) do
        table.insert(roots, p)
    end

    -- 去重并验证目录存在
    local filtered = {}
    local exists = {}
    for _, p in ipairs(roots) do
        if not exists[p] and os.isdir(p) then
            table.insert(filtered, p)
            exists[p] = true
        end
    end
    return filtered
end

-- ==========================================
-- 辅助函数：定位 mxcc
-- ==========================================
local function _resolve_mxcc_path()
    local path_env = os.getenv("PATH") or ""
    for bindir in string.gmatch(path_env, "([^:]+)") do
        local candidate = path.join(bindir, "mxcc")
        if os.isfile(candidate) then
            return candidate
        end
    end

    for _, root in ipairs(_collect_maca_roots()) do
        local candidates = {
            path.join(root, "mxgpu_llvm/bin/mxcc"),
            path.join(root, "bin/mxcc")
        }
        for _, candidate in ipairs(candidates) do
            if os.isfile(candidate) then
                return candidate
            end
        end
    end
    return nil
end

-- ==========================================
-- 辅助函数：为 target 应用 mxcc 编译器
-- ==========================================
local function _apply_mxcc_for_target()
    local mxcc = _resolve_mxcc_path()
    if not mxcc then
        raise("mxcc not found. Please add mxcc to PATH or set MACA_PATH/MXMACA_HOME correctly.")
    end

    local mxcc_wrapper = path.join(os.projectdir(), "scripts/mxcc_wrapper.sh")
    if not os.isfile(mxcc_wrapper) then
        raise("mxcc wrapper not found: " .. mxcc_wrapper)
    end

    -- 使用 “已知工具@绝对路径” 语法，避免 unknown tool script 错误
    -- 参考 xmake API: set_toolset("cc", "gcc@/path/to/compiler")
    set_toolset("cc", "gcc@" .. mxcc_wrapper)
    set_toolset("cxx", "gcc@" .. mxcc_wrapper)
    set_toolset("ld", "gcc@" .. mxcc_wrapper)
    set_toolset("sh", "gcc@" .. mxcc_wrapper)
    add_cxflags("-x maca", {force = true})
end

-- ==========================================
-- 辅助函数：应用 MACA 环境配置 (已更新 mcblas 路径)
-- ==========================================
local function _apply_maca_env_for_target()
    -- ❌ 绝对不要设置 set_toolset("cu")
    
    local roots = _collect_maca_roots()
    if #roots == 0 then
        warn("Warning: No valid MACA SDK root found. Please set MACA_PATH or install SDK.")
    end

    for _, root in ipairs(roots) do
        -- 1. 添加基础 include 路径
        local include_candidates = {
            path.join(root, "include"),
            path.join(root, "include/maca"),
            path.join(root, "include/mx"),
            path.join(root, "mxgpu_llvm/include"),
            path.join(root, "tools/cu-bridge/include"),
            path.join(root, "tools/cu-bridge/include/bridge/runtime"),
            path.join(root, "tools/cu-bridge/include/bridge/blas")
        }
        for _, inc in ipairs(include_candidates) do
            if os.isdir(inc) then
                add_includedirs(inc, {public = true, system = true})
            end
        end

        -- ✅ 添加 mcblas 专用 include 路径 (根据你的要求)
        -- 对应: ${MACA_PATH}/include/mcblas
        local mcblas_inc = path.join(root, "include/mcblas")
        if os.isdir(mcblas_inc) then
            add_includedirs(mcblas_inc, {public = true, system = true})
            -- print("Added mcblas include: " .. mcblas_inc) -- 调试用
        else
            -- 如果找不到，尝试警告（有时可能合并到主 include 中）
            -- warn("mcblas include dir not found at: " .. mcblas_inc)
        end

        -- 2. 添加基础 lib 路径
        local lib_candidates = {
            path.join(root, "lib64"),
            path.join(root, "lib"),
            path.join(root, "lib/x64")
        }
        for _, libdir in ipairs(lib_candidates) do
            if os.isdir(libdir) then
                add_linkdirs(libdir)
                if is_plat("linux") then
                    add_rpathdirs(libdir)
                end
            end
        end
        
        -- ✅ 确保 libmcblas.so 所在目录被包含
        -- 对应: ${MACA_PATH}/lib (通常上面已经包含了，这里再次确认)
        local mcblas_lib_dir = path.join(root, "lib")
        if os.isdir(mcblas_lib_dir) then
             add_linkdirs(mcblas_lib_dir)
             if is_plat("linux") then
                add_rpathdirs(mcblas_lib_dir)
            end
        end
    end
end

-- ==========================================
-- Target: llaisys-device-mx
-- ==========================================
target("llaisys-device-mx")
    set_kind("shared")
    _apply_mxcc_for_target()

    if is_plat("linux") then
        add_rpathdirs("$ORIGIN")
    end
    
    if not is_plat("windows") then
        add_cxflags("-fPIC", "-Wno-unknown-pragmas", {force = true})
    end

    _apply_maca_env_for_target()

    -- wcuda* symbols (including __wcuda_version_internal__) are provided by libruntime_cu.so
    add_links("runtime_cu")

    set_languages("cxx17")
    set_warnings("all", "error")

    -- 指向生成的 mx 目录代码
    add_files("../src/device/mx/*.cpp") 
    
    on_install(function (target) end)
target_end()

-- ==========================================
-- Target: llaisys-ops-mx
-- ==========================================
target("llaisys-ops-mx")
    set_kind("shared")
    _apply_mxcc_for_target()

    if is_plat("linux") then
        add_rpathdirs("$ORIGIN")
    end
    
    if not is_plat("windows") then
        add_cxflags("-fPIC", "-Wno-unknown-pragmas", {force = true})
    end

    _apply_maca_env_for_target()

    -- Keep explicit dependency on runtime_cu for robust runtime symbol resolution.
    add_links("runtime_cu")

    add_deps("llaisys-tensor")
    set_languages("cxx17")
    set_warnings("all", "error")
    
    -- ✅ 链接 mcblas 库
    -- 库文件名是 libmcblas.so -> 链接名是 "mcblas"
    add_links("mcblas") 

    -- 指向生成的 mx 目录代码
    add_files("../src/ops/*/mx/*.cpp")

    on_install(function (target) end)
target_end()